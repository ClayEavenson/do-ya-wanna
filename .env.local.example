# Do Ya Wanna? — Local environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# ── Resend (beta invite emails) ───────────────────────────────────────────────
# Get your key at https://resend.com/api-keys
# Leave blank in local dev to simulate success without sending real emails.
RESEND_API_KEY=

# Email address that receives new beta signups
BETA_NOTIFY_TO=wanna@steamworks.io

# Verified sender on Resend (must match a domain you've verified in Resend)
# Format: Display Name <address@yourdomain.com>
RESEND_FROM_EMAIL=Do Ya Wanna <noreply@yourdomain.com>

# ── Site URL (used for OG metadata) ──────────────────────────────────────────
# Set to your Vercel production URL or custom domain once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
